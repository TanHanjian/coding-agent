# Copy this file to .env for local development. Do not commit the copied file.
# Production should set the same values through its environment or secret manager.

# Required once the Chat / Eino runtime is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=

# Required for Chat and its summary model calls; no capacity defaults are inferred.
# Confirm the context window for the selected endpoint AND model, then enter a
# positive integer. A model name alone does not establish gateway capacity.
OPENAI_CONTEXT_WINDOW_TOKENS=
# Positive integer: the generation cap sent to the provider and reserved locally.
# For reasoning models, this must cover reasoning and visible output tokens as
# counted by the selected provider parameter.
OPENAI_MAX_OUTPUT_TOKENS=
# Explicit non-negative integer: allowance for estimation/protocol overhead.
# Enter 0 explicitly if no margin is intended; an empty value is unconfigured.
# Output cap + safety margin must be strictly less than the context window.
OPENAI_CONTEXT_SAFETY_MARGIN_TOKENS=
# Exactly max_tokens or max_completion_tokens, according to endpoint support.
# Only the chosen field is sent, with the OPENAI_MAX_OUTPUT_TOKENS value.
OPENAI_OUTPUT_LIMIT_MODE=

# Optional: use an OpenAI-compatible gateway endpoint when required.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: independent LLM Judge for Agent evaluations.
# When omitted, evaluation still runs deterministic checks but reports status=unscored.
# These may use the same OpenAI-compatible gateway, but a separate model is recommended.
# The independent judge does not inherit the Chat budget or output cap. The generic
# model factory allows a fully absent budget for independent judges; partial budgets fail.
# Live evaluation candidates require the same explicit budget and input guard as Chat.
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_BASE_URL=https://api.openai.com/v1

# Optional application settings.
# APP_ADDR=127.0.0.1:8080
# APP_LOG_LEVEL=info
# APP_DATA_DIR=

# Enables per-node Agent Graph debug logs locally. Never logs prompts or tool results.
# AGENT_DEBUG=false

# Optional CozeLoop integration. Disabled by default.
# COZELOOP_ENABLED=false
# COZELOOP_WORKSPACE_ID=
# COZELOOP_API_TOKEN=
# COZELOOP_ENVIRONMENT=local
# COZELOOP_SERVICE_NAME=interview-memory-agent
# Content capture/upload is disabled by default and requires a local consent record.
# COZELOOP_CAPTURE_CONTENT=false
# Evaluation APIs are separately disabled; uploading dataset content needs both flags
# plus an active consent record for the configured workspace.
# COZELOOP_API_BASE_URL=https://api.coze.cn
# COZELOOP_EVALUATION_ENABLED=false
# COZELOOP_EVALUATION_CONTENT_UPLOAD_ENABLED=false
# Optional Prompt Hub integration. It requires COZELOOP_ENABLED=true.
# COZELOOP_PROMPT_ENABLED=false
# AGENT_PROMPT_KEY=interview-review-agent
# Leave the version empty to resolve by label.
# AGENT_PROMPT_VERSION=
# AGENT_PROMPT_LABEL=development
# Prompt cache settings use Go duration syntax.
# COZELOOP_PROMPT_CACHE_SIZE=100
# COZELOOP_PROMPT_REFRESH_INTERVAL=10m
