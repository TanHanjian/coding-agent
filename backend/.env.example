# Copy this file to .env for local development. Do not commit the copied file.
# Production should set the same values through its environment or secret manager.

# Required once the Chat / Eino runtime is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: use an OpenAI-compatible gateway endpoint when required.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: independent LLM Judge for Agent evaluations.
# When omitted, evaluation still runs deterministic checks but reports status=unscored.
# These may use the same OpenAI-compatible gateway, but a separate model is recommended.
# EVAL_JUDGE_API_KEY=
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_BASE_URL=https://api.openai.com/v1

# Optional application settings.
# APP_ADDR=127.0.0.1:8080
# APP_LOG_LEVEL=info
# APP_DATA_DIR=

# Enables per-node Agent Graph debug logs locally. Never logs prompts or tool results.
# AGENT_DEBUG=false

# Optional CozeLoop integration. Disabled by default.
# COZELOOP_ENABLED=false
# COZELOOP_WORKSPACE_ID=
# COZELOOP_API_TOKEN=
# COZELOOP_ENVIRONMENT=local
# COZELOOP_SERVICE_NAME=interview-memory-agent
# Content capture is useful for local evaluation; disable it for sensitive data.
# COZELOOP_CAPTURE_CONTENT=true
